{
  "name": "ui-motion-skill",
  "version": "1.1.0",
  "description": "UI animation and motion design skill for AI coding agents: accessible micro-interactions, scroll effects, and an interactive CLI installer.",
  "type": "module",
  "bin": {
    "ui-motion-skill": "./bin/cli.mjs",
    "ui-motion": "./bin/cli.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "skills/",
    "README.md",
    "LICENSE",
    "docs/compatibility.md"
  ],
  "scripts": {
    "start": "node ./bin/cli.mjs",
    "test:help": "node ./bin/cli.mjs --help",
    "check": "node scripts/check.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/installer.test.mjs && tsx --test tests/recipes.test.tsx",
    "test:package": "node scripts/package-smoke.mjs",
    "github:metadata": "node scripts/github-metadata.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adnanrahim110/ui-motion-skill.git"
  },
  "homepage": "https://github.com/adnanrahim110/ui-motion-skill#readme",
  "bugs": {
    "url": "https://github.com/adnanrahim110/ui-motion-skill/issues"
  },
  "keywords": [
    "agent-skills",
    "ai-coding-agents",
    "ui-motion",
    "motion-design",
    "skill-md",
    "claude-code",
    "cursor",
    "codex",
    "antigravity",
    "windsurf",
    "github-copilot",
    "gemini-cli",
    "cline",
    "roo-code",
    "ui-animation",
    "micro-interactions",
    "accessibility",
    "reduced-motion",
    "react",
    "tailwindcss",
    "motion",
    "framer-motion",
    "design-engineering",
    "css-animations",
    "scrollytelling",
    "scroll-driven-animations",
    "parallax",
    "cursor-effects"
  ],
  "author": "Adnan Rahim <https://github.com/adnanrahim110>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "motion": "^14.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
