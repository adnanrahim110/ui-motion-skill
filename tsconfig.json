{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["skills/ui-motion/assets/react/**/*.ts", "skills/ui-motion/assets/react/**/*.tsx", "tests/**/*.tsx", "demo/src/**/*.ts", "demo/src/**/*.tsx"]
}
